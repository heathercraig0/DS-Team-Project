# using a different package for a dataset
library(ISLR)
library(MASS)
# Hitters dataset
?Hitters
lm.mod.full <- lm(Salary~., data = Hitters)
lm.mod.null <- lm(Salary~1, data = Hitters)
View(lm.mod.full)
View(lm.mod.null)
lm.step.back <- stepAIC(lm.mod.full)
# we could "turn-off" the messages by using trace=F
lm.step.back <- stepAIC(lm.mod.full,trace = F)
View(lm.step.back)
# here is the selected model
summary(lm.step.back)
lm.step.forw <- stepAIC(lm.mod.null,
direction = "forward",
trace = F,
scope = list(upper=lm.mod.full, lower=lm.mod.null))
# here is the selected model
summary(lm.step.forw)
lm.step.back$coefficients
lm.step.forw$coefficients
# selecting only three variables
data <- airquality[, c("Ozone", "Solar.R", "Wind")]
#checking the dimensions
dim(data)
# identify any missing data
apply(is.na(data),2,sum)
# make a copy
data.sim <- data
#setting the seed for simulation
set.seed(123)
# making randomly 10 observations from Wind variable as missing
data.sim$Wind[sample(1:nrow(data),10)] <- NA
# now let's check again
apply(is.na(data.sim),2,sum)
apply(is.na(cohort),2,sum)
colSums(is.na(cohort))
# now let's check again
apply(is.na(data.sim),2,sum)
# Complete observations approach
data.nomiss <- na.omit(data.sim)
apply(is.na(data.nomiss),2,sum)
dim(data.nomiss)
colMeans(data.nomiss)
cor(data.nomiss)
apply(!is.na(data.sim),2,sum)
colMeans(data.sim, na.rm = T)
cor(data.sim, use = "pairwise")
# Mean imputation
# conveniently using the mice package
library(mice)
# imputation using the mean
imp.res <- mice(data.sim, method = "mean", m = 1, maxit = 1)
# plotting function for identifying the imputed values
xyplot(imp.res, Ozone ~ Solar.R)
# extracting the full imputed dataset
imp.mean <- complete(imp.res)
colMeans(imp.mean)
cor(imp.mean)
# prediction imputation
fit <- lm(Ozone ~ Solar.R, data = data.sim)
pred <- predict(fit, newdata = ic(data.sim))
# ic function from mice package: it extracts incomplete cases
?ic
# check pred and ic(data.sim)
cbind(pred, ic(data.sim))
# more conveniently using mice
# selecting only two variables
data.lim <- airquality[, c("Ozone", "Solar.R")]
imp <- mice(data.lim, method = "norm.predict", seed = 11,
m = 1, print = FALSE)
xyplot(imp, Ozone ~ Solar.R)
# stochastic regression
imp.stoch <- mice(data.lim, method = "norm.nob", seed = 32,
m = 5, print = FALSE)
xyplot(imp.stoch, Ozone ~ Solar.R)
fit.stoch <- with(imp.stoch, lm(Ozone ~ Solar.R))
summary(pool(fit.stoch))
# this is how we can extract the actual imputed dataset
imputed.data.frame <- complete(imp.stoch, action = 1)
# LOCF
# checking the fill function from the tidyr package
?tidyr::fill
imp.lofc <- tidyr::fill(airquality,Ozone)
cbind(airquality[,1],imp.lofc[,1])
